# Aether — optional MCP tool credentials.
# Copy to .env and fill in only what you use. Every key here is optional;
# each tool self-disables if its key is missing. Model provider credentials
# (Anthropic/OpenAI/local endpoint) are NOT set here — configure those from
# the app's own Settings panel after it's running (Connect provider).

TAVILY_API_KEY=
FIRECRAWL_API_KEY=
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=
JIRA_URL=
JIRA_PERSONAL_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_PERSONAL_TOKEN=
GITLAB_API_URL=
GITLAB_PERSONAL_ACCESS_TOKEN=

# Bind address/port (see README.md before exposing AETHER_HOST=0.0.0.0
# publicly — there is no built-in auth, front it with your own VPN/tunnel).
# AETHER_HOST=127.0.0.1
# AETHER_PORT=8500
# AETHER_DATA_DIR=~/.aether/data
